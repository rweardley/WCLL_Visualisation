#!/bin/bash
#SBATCH -A fus166
#SBATCH -p batch
#SBATCH -t 02:00:00
#SBATCH -N 8
#SBATCH --ntasks-per-node=128
#SBATCH --cpus-per-task=1
#SBATCH -J mhd0
#SBATCH -o log_%x-%j.out
#SBATCH --exclusive
#SBATCH --array=0-37

source $HOME/riker_venv/bin/activate

# use OpenMPI instead of MPICH, solves a problem limiting number of processes
export LD_LIBRARY_PATH=/usr/mpi/gcc/openmpi-4.1.9a1/lib64:$LD_LIBRARY_PATH

BATCH=1
RUN=$(printf '%02d' "${SLURM_ARRAY_TASK_ID}")

SOURCE_DIR="/lustre/orion/fus166/proj-shared/rweb/gb_final/animation/buo0_mhd0_mc1_stride4/${RUN}run_${BATCH}"
OUTPUT_DIR="/lustre/orion/fus166/proj-shared/rweb/gb_final/animation/buo0_mhd0_mc1_stride4/${RUN}run_${BATCH}"
PINK=1
MHDPINK=0
CURRPINK=0
MESH="m3fl"
CASENAME="pink5m3_no_buo"

srun --mpi=pmix --cpu-bind=cores --threads-per-core=1 --label python3 ../../../split/split_nek5000.py $SOURCE_DIR $OUTPUT_DIR $PINK $MHDPINK $CURRPINK $MESH $CASENAME

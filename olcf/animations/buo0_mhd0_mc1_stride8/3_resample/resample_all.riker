#!/bin/bash
#SBATCH -A FUS166
#SBATCH -p batch
#SBATCH -t 02:00:00
#SBATCH --nodes=8
#SBATCH --ntasks-per-node=128
#SBATCH --cpus-per-task=1
#SBATCH -J mhd0_rsmpl_stride8
#SBATCH -o log_%x-%j.out
#SBATCH --exclusive
#SBATCH --array=0-37

cd $SLURM_SUBMIT_DIR
date

module load paraview/6.1.1-mpi
export UCX_NET_DEVICES=mlx5_0:1
PARAVIEW_PATH=$OLCF_PARAVIEW_ROOT

BATCH=1
RUN=$(printf '%02d' "${SLURM_ARRAY_TASK_ID}")

filter_domains=0

input_dir="/lustre/orion/fus166/proj-shared/rweb/gb_final/animation/buo0_mhd0_mc1_stride8/${RUN}run_${BATCH}"
output_dir="/lustre/orion/fus166/proj-shared/rweb/gb_final/animation/buo0_mhd0_mc1_stride8/resampled/${RUN}run_${BATCH}"
res=400
casename="pink5m3_no_buo"

# get list of checkpoints to use as paraview timesteps

timesteps=( $(ls ${input_dir}/*.f[0-9][0-9][0-9][0-9][0-9] | sed 's/.*\.f//' | sort -un | awk '{sub(/^0+/,""); if ($0=="") $0="0"} 1') )

zero_file="${input_dir}/zero_checkpoint"
[[ -f "$zero_file" ]] || { echo "error: $zero_file missing" >&2; exit 1; }
keep_zero="$(sed -n 's/^keep_zero:[[:space:]]*//p' "$zero_file")"

if [[ "$keep_zero" != "yes" ]]; then
    timesteps=( "${timesteps[@]:1}" )   # f00000 is mesh-only here; drop it
fi

mkdir -p $output_dir

domains=("pbli"
         "water_sh"
         "water_tbm")

for domain in ${domains[@]}; do
    input_file="${input_dir}/${domain}_${casename}.nek5000"
    output_file="${output_dir}/${domain}"
    for ts_idx in ${timesteps[@]}; do
        echo "[$ts_idx] >>> \bin\bash >>> launching python"
        srun -n $SLURM_NTASKS -c 1 $PARAVIEW_PATH"/bin/pvbatch"  \
            ../../../resample/presplit_resample.py $ts_idx $filter_domains $input_file $output_file $res
    done
done

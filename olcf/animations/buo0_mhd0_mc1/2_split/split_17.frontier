#!/bin/bash
#SBATCH -A fus166
#SBATCH -t 02:00:00
#SBATCH -N 16
#SBATCH --ntasks-per-node=56
#SBATCH -J mhd0_split17
#SBATCH -o log_%x-%j.out
#SBATCH --array=1-3:1

module load cray-python/3.11.7

RUN=17

SOURCE_DIR="/lustre/orion/fus166/proj-shared/rweb/gb_final/animation/buo0_mhd0_mc1/${RUN}run_${SLURM_ARRAY_TASK_ID}"
OUTPUT_DIR="/lustre/orion/fus166/proj-shared/rweb/gb_final/animation/buo0_mhd0_mc1/${RUN}run_${SLURM_ARRAY_TASK_ID}"
PINK=1
MHDPINK=0
CURRPINK=0
MESH="m3fl"
CASENAME="pink5m3_no_buo"

srun --cpu-bind=cores --threads-per-core=1 --label python3 ../../../split/split_nek5000.py $SOURCE_DIR $OUTPUT_DIR $PINK $MHDPINK $CURRPINK $MESH $CASENAME

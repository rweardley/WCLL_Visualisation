#!/bin/bash
#SBATCH -A FUS166
#SBATCH -p gpu
#SBATCH -t 04:00:00
#SBATCH --nodes=1
#SBATCH --gpus=2
#SBATCH --ntasks-per-node=2
#SBATCH --cpus-per-gpu=32
#SBATCH --exclusive
#SBATCH -J mhd0_rdr_ts_stride2
#SBATCH -o log_%x-%j.out

cd $SLURM_SUBMIT_DIR
date

module load paraview/6.1.1-gpu-mpi
export UCX_NET_DEVICES=mlx5_0:1

BATCH=1
RUN=13

input_dir="/lustre/orion/fus166/proj-shared/rweb/gb_final/animation/buo0_mhd0_mc1_timeRescaled_stride2/resampled/${RUN}run_${BATCH}"
output_dir="/lustre/orion/fus166/proj-shared/rweb/gb_final/animation/buo0_mhd0_mc1_timeRescaled_stride2/vol_fluids_velocity_all_jet_split/${RUN}run_${BATCH}"

state_file="../../vol_fluids_velocity_all_jet_split.pvsm"
cad_path="${HOME}/CAD/WCLL/solid_vols_vis.stl"

pvbatch --force-offscreen-rendering --opengl-window-backend=EGL ../../render_dataset.py $state_file $input_dir $cad_path $output_dir

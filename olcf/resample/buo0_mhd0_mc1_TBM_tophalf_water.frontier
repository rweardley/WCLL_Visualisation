#!/bin/bash
#SBATCH -A FUS166
#SBATCH -p batch
#SBATCH --nodes=32
#SBATCH --ntasks-per-node=4
#SBATCH --cpus-per-task=14
#SBATCH -t 02:00:00
##SBATCH -q debug
#SBATCH -J resth_buo0_mhd0_mc1
#SBATCH -o log_%x-%j.out
#SBATCH --exclusive

cd $SLURM_SUBMIT_DIR
date

PARAVIEW_PATH="/ccs/home/rweardleybrunt/ParaView/ParaView-6.1.0-MPI-Linux-Python3.12-x86_64"

filter_domains=0
timesteps=(1)
input_dir="/lustre/orion/fus166/proj-shared/rweb/gb_final/buo0_mhd0_mc1/"
output_dir="/lustre/orion/fus166/proj-shared/rweb/gb_final/buo0_mhd0_mc1/resampled_TBM_tophalf"
res=1000
input_bounds="-0.461538,14.3,-5.63846,5.63846,-3,14.6846"
casename="pink5m3_no_buo"

mkdir -p $output_dir

domains=("water_tbm")

for domain in ${domains[@]}; do
    input_file="${input_dir}/${domain}_${casename}.nek5000"
    output_file="${output_dir}/${domain}"
    for ts_idx in ${timesteps[@]}; do
        echo "[$ts_idx] >>> \bin\bash >>> launching python"
        $PARAVIEW_PATH"/bin/mpiexec" -n $SLURM_NTASKS $PARAVIEW_PATH"/bin/pvbatch"  \
            presplit_resample_focused.py $ts_idx $filter_domains $input_file $output_file $res $input_bounds
    done
done

#!/bin/bash
#SBATCH -A fus166
#SBATCH -q debug
#SBATCH -t 01:30:00
#SBATCH -N 16
#SBATCH --ntasks-per-node=56
#SBATCH -J wk5_m3_yes_mhd
#SBATCH -o log_%x-%j.out

module load cray-python/3.11.7

SOURCE_DIR="/lustre/orion/proj-shared/nfu106/ylan/cases/gb26/pink26/wk5_m3_yes_mhd/dat_r2/"
OUTPUT_DIR="/lustre/orion/fus166/proj-shared/rweb/wk5_m3_yes_mhd/dat_r2/"
PINK=1
MHDPINK=0
CURRPINK=0
# MHDPINK=1 # have these but skipping
# CURRPINK=1 # have these but skipping
MESH="m3"
CASENAME="pink5m3"

srun --cpu-bind=cores --threads-per-core=1 --label python3 split_nek5000.py $SOURCE_DIR $OUTPUT_DIR $PINK $MHDPINK $CURRPINK $MESH $CASENAME
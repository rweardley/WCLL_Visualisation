#!/bin/bash
#SBATCH -A fus166
##SBATCH -q debug
#SBATCH -t 02:00:00
#SBATCH -N 16
#SBATCH --ntasks-per-node=56
#SBATCH -J buo1_mhd1_mc1
#SBATCH -o log_%x-%j.out

module load cray-python/3.11.7

SOURCE_DIR="/lustre/orion/fus166/proj-shared/rweb/gb_final/buo1_mhd1_mc1/"
OUTPUT_DIR="/lustre/orion/fus166/proj-shared/rweb/gb_final/buo1_mhd1_mc1/"
PINK=1
MHDPINK=1
CURRPINK=1
MESH="m3"
CASENAME="pink5m3_mhd"

srun --cpu-bind=cores --threads-per-core=1 --label python3 split_nek5000.py $SOURCE_DIR $OUTPUT_DIR $PINK $MHDPINK $CURRPINK $MESH $CASENAME
